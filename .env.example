# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRON_SECRET="replace-with-a-random-secret"

# ── Public API (v1) ──────────────────────────────────────────
# Platform-level emergency disable switch: set to 1 to turn every /api/v1
# request away without touching data. Unset (or 0) in normal operation.
LEDGERPRO_API_DISABLED="0"
# Per-key rate limits (optional; defaults shown). "report" is the stricter
# class reserved for expensive report endpoints.
# API_RATE_LIMIT_MINUTE=120
# API_RATE_LIMIT_DAY=5000
# API_RATE_LIMIT_REPORT_MINUTE=10
# API_RATE_LIMIT_REPORT_DAY=500
